# PostgreSQL connection (local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=property_crm

# JWT secret for custom auth
JWT_SECRET=aaqarplus-dev-secret-change-in-production
JWT_REFRESH_SECRET="PUT_A_STRONG_RANDOM_SECRET_HERE"

# Seed first superadmin (dev helper)
SUPERADMIN_EMAIL=admin@aaqarplus.sa
SUPERADMIN_PASSWORD=YourStrongPassword123!
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PHONE=

# Company info for payment receipts (سند قبض)
COMPANY_NAME_AR=اسم الشركة
COMPANY_NAME_EN=Company Name
COMPANY_DESC_AR=للمقاولات والخدمات العقارية
COMPANY_DESC_EN=For Contracting & Real Estate Services
COMPANY_PHONE=05XXXXXXXX
COMPANY_CR=XXXXXXXXXX
COMPANY_VAT=3XXXXXXXXXXXXXX
COMPANY_ADDRESS_AR=العنوان هنا - حي - المدينة
COMPANY_ADDRESS_EN=Your Address Here - District - City
COMPANY_LOGO_URL=
# Maintenance AI (Predictive Maintenance)
MAINTENANCE_PREDICTION_BATCH_SIZE=100
MAINTENANCE_CRITICAL_THRESHOLD=75
MAINTENANCE_HIGH_THRESHOLD=50

# AI smart reports (تقرير الذكاء الاصطناعي) — Cerebras preferred (fast + cheap)
# Add ONE of these two keys. CEREBRAS wins if both are set.
CEREBRAS_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gpt-oss-120b   # default model (Cerebras) — gpt-4o-mini is the OpenAI default

# Public app URL (used in reset-password emails)
APP_URL=http://localhost:3000

# SMTP email (forgot-password) — optional; unset in dev logs instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AaqarPlus <noreply@aaqarplus.com>"

# SMS gateway (notification_queue SMS rows) — unset = console-log stub
SMS_PROVIDER=unifonic
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.unifonic.com

# ZATCA Phase 2
ZATCA_CSID=
ZATCA_CSID_SECRET=
ZATCA_PRIVATE_KEY_PATH=
ZATCA_API_BASE=https://api.zatca.gov.sa
ZATCA_COMPLIANCE_ENDPOINT=/core/compliance/invoices
ZATCA_PRODUCTION_ENDPOINT=/core/production/invoices
ZATCA_OTP=

# S3-compatible storage (documents/images) — unset = local disk
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Tap Payments (SaaS billing)
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_BASE_URL=https://api.tap.company/v2
